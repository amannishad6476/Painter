# ==============================================================================
# Lucknow Painter Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://www.munnalalpainter.in,https://munnalalpainter.in,http://localhost:3000,http://localhost:5173,http://localhost:5000

# ------------------------------------------------------------------------------
# PostgreSQL Database (Neon DB Serverless)
# ------------------------------------------------------------------------------
# Example: postgresql://<user>:<password>@<neon-host>/<dbname>?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# Cloudinary Persistent Media Storage & CDN
# ------------------------------------------------------------------------------
# Option A: Full Cloudinary URL
# Example: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Option B: Individual Cloudinary Credentials (Alternative to CLOUDINARY_URL)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# Security Secrets
# ------------------------------------------------------------------------------
# Secret key used for signing Admin JWT tokens (HMAC-SHA256)
ADMIN_JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
